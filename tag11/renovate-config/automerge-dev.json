{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "devDependencies: Minor und Patch automatisch mergen",
  "packageRules": [
    {
      "description": "shop:automerge-dev devDependencies automatisch mergen",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev-tools",
      "automerge": true
    }
  ]
}
