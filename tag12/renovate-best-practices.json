{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "vulnerabilityFixStrategy": "highest"
  },
  "packageRules": [
    {
      "description": "Nur zur Demo: 3 Monate ohne Release = verwaist",
      "matchPackageNames": ["*"],
      "abandonmentThreshold": "3 months"
    }
  ]
}
