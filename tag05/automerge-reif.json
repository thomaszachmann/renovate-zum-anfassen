{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "npm"
  ],
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "devDependencies: patch und minor automatisch mergen",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "branch",
      "minimumReleaseAge": "3 days"
    }
  ],
  "platformAutomerge": false
}
