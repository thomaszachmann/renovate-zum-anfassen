{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "timezone": "Europe/Berlin",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 3,
  "packageRules": [
    {
      "description": "Non-Major nur montags vor 6 Uhr",
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["* 0-5 * * 1"]
    }
  ]
}
