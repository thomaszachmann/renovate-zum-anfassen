{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Werkzeug-Versionen im Makefile",
      "managerFilePatterns": ["/(^|/)Makefile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+_VERSION := (?<currentValue>\\S+)"
      ]
    }
  ]
}
