{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 0,
  "hostRules": [
    {
      "matchHost": "http://127.0.0.1:3000/api/packages/",
      "hostType": "npm",
      "token": "{{ secrets.FORGEJO_PACKAGES }}"
    },
    {
      "matchHost": "127.0.0.1",
      "hostType": "docker",
      "username": "renovate-bot",
      "password": "{{ secrets.FORGEJO_PACKAGES }}",
      "insecureRegistry": true
    }
  ],
  "packageRules": [
    {
      "description": "Heute nur die internen Pakete der Org shop",
      "matchPackageNames": ["!@shop/**", "!**/shop/base"],
      "enabled": false
    }
  ]
}
